# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Data and experiments
data/nir/*
data/rgb/*
!data/nir/.gitkeep
!data/rgb/.gitkeep
data/mp_cache.json
*.ckpt
*.pth
*.pt
*.onnx
*.rknn
# Renamed checkpoints (e.g. .pth.collapsed_e185, .ckpt.bak) bypass the bare-suffix rules above
*.ckpt.*
*.pth.*
*.pt.*
# Belt-and-braces: nothing under any experiments checkpoints dir should be tracked
experiments/*/checkpoints/
wandb/

# Training logs
*.log
*.log.*
logs/
experiments/_archive/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code local settings
.claude/

